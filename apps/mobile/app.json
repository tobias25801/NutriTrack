{
  "expo": {
    "name": "NutriTrack",
    "slug": "nutritrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1115"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutritrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriTrack uses the camera to scan barcodes and analyze meals.",
        "NSPhotoLibraryUsageDescription": "NutriTrack uses photos to analyze meals with AI.",
        "NSHealthShareUsageDescription": "NutriTrack reads health data to track your nutrition.",
        "NSHealthUpdateUsageDescription": "NutriTrack logs nutrition data to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1115"
      },
      "package": "com.nutritrack.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-barcode-scanner",
        { "cameraPermission": "Allow NutriTrack to access camera." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "nutritrack"
  }
}
